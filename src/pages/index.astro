---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import TopicCard from '../components/TopicCard.astro';

const topics = [
  {
    title: 'Business and Economy',
    description: 'Data on small businesses, industry, imports, exports, and trade.',
    href: '/topics/business'
  },
  {
    title: 'Crime and Justice',
    description: 'Information on courts, police, prisons, offenders, borders, and immigration.',
    href: '/topics/crime'
  },
  {
    title: 'Education',
    description: 'Covers students, training, qualifications, and the National Curriculum.',
    href: '/topics/education'
  },
  {
    title: 'Health',
    description: 'Find information on smoking, drugs, alcohol, medicine performance, and hospitals.',
    href: '/topics/health'
  }
];
---

<Layout title="Welcome">
  <section class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      Nigeria Open Data Platform
    </h1>
    <p class="text-xl text-gray-600 mb-8">
      Access trusted government and public data to build better products and services
    </p>
    <SearchBar />
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold text-gray-900 mb-6">Popular Topics</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {topics.map(topic => (
        <TopicCard {...topic} />
      ))}
    </div>
  </section>

  <section class="bg-primary-50 rounded-lg p-8 mb-12">
    <h2 class="text-2xl font-semibold text-gray-900 mb-4">
      Why Use Nigeria Open Data?
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Trusted Data Source</h3>
        <p class="text-gray-600">
          Access verified and up-to-date data from government and public bodies.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Easy to Use</h3>
        <p class="text-gray-600">
          Simple search and download features make finding and using data effortless.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Wide Coverage</h3>
        <p class="text-gray-600">
          Explore data across multiple domains from business to environment.
        </p>
      </div>
    </div>
  </section>
</Layout>