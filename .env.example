# ─── CKAN ─────────────────────────────────────────────────────────────────────
CKAN_URL=http://localhost:5000
NEXT_PUBLIC_CKAN_URL=http://localhost:5000
CKAN_API_KEY=your_ckan_admin_api_token_here
CKAN_ORG_ID=nigeriaopendata

# ─── Database Security ────────────────────────────────────────────────────────
# Use strong passwords in production.
CKAN_DB_PASSWORD=ckan
PIPELINE_DB_PASSWORD=pipeline
DS_RO_PASS=datastore

# ─── Pipeline Database ────────────────────────────────────────────────────────
# Dedicated PostgreSQL for CDM + manifest tables (runs on port 5433)
PIPELINE_DB_URL=postgresql://pipeline:pipeline@localhost:5433/pipeline

# ─── Prefect ──────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── Frontend Security ────────────────────────────────────────────────────────
# URL allowed to call the pipeline APIs (CORS)
FRONTEND_URL=http://localhost:3000

# ─── Landing Zone ─────────────────────────────────────────────────────────────
# Drop files here to trigger event-driven ingestion (file watcher polls every 15 min)
# Subfolders: data/raw/cbn/, data/raw/nigeria_data_portal/
LANDING_ROOT=./data/raw
