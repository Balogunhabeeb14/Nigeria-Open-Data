# Copy to .env and fill in. Never commit .env.

# ── CKAN ──────────────────────────────────────────────────────────────────────
# API token of a CKAN sysadmin. Without it the pipeline still loads data into
# its own database but publishes nothing to the portal.
CKAN_API_KEY=
CKAN_ORG_ID=nigeriaopendata
CKAN_DB_PASSWORD=change-me
DS_RO_PASS=change-me

# ── Pipeline database ─────────────────────────────────────────────────────────
PIPELINE_DB_PASSWORD=change-me
# Only needed when running the pipeline outside docker-compose:
# PIPELINE_DB_URL=postgresql://pipeline:change-me@localhost:5433/pipeline

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_CKAN_URL=http://localhost:5000

# ── Optional ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT_SECONDS=60
# REQUEST_MAX_RETRIES=3

# ── Site and admin ────────────────────────────────────────────────────────────
# An address the team really receives mail at. Empty = the site links to the
# GitHub issue tracker instead.
CONTACT_EMAIL=
# Long random string. Needed (as the X-Admin-Token header) to register
# publishers and sources, upload files or trigger ingestion through the
# pipeline API. Empty = those endpoints are switched off.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# 'local' = built-in catalogue (docker-compose.lite.yml sets this for you).
# CATALOG_BACKEND=ckan
